generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StatusReserva {
  pendente
  aprovado
  recusado
  cancelado
}

model Usuario {
  id       Int     @id @default(autoincrement())
  nome     String
  email    String  @unique
  telefone String  // 👈 ESTE AQUI
  senha    String
  tipo     String
  status   String  @default("ativo")
  reservas Reserva[]
}

model Laboratorio {
  id          Int       @id @default(autoincrement())
  nome        String
  capacidade  Int
  recursos    String[]  // Lista de recursos, como projetor, computador, etc.
  reservas    Reserva[]
}

model Reserva {
  id             Int            @id @default(autoincrement())
  data           DateTime       // 👉 Apenas a data da reserva
  horaInicio     String         // 👉 Horário de início, ex: "08:00"
  horaFim        String         // 👉 Horário de fim, ex: "10:00"
  status         StatusReserva  // pendente, aprovado, recusado, cancelado
  motivo         String?        // Motivo da recusa ou cancelamento

  usuarioId      Int
  laboratorioId  Int

  usuario        Usuario        @relation(fields: [usuarioId], references: [id])
  laboratorio    Laboratorio    @relation(fields: [laboratorioId], references: [id])
}


model Registro {
  id        Int       @id @default(autoincrement())
  docente   String
  email     String
  data      DateTime
  status    String
  detalhes  String? // Adicionado o campo detalhes
}

